# Copie para .env.local (dev) e cadastre as mesmas variáveis no projeto da Vercel (Settings → Environment Variables).
# Nunca faça commit do .env.local.

# Conta Atlassian dona do token (e-mail @cogna.com.br)
JIRA_USERNAME=seu.email@cogna.com.br
# API token clássico: id.atlassian.com → Segurança → Criar e gerenciar tokens de API → "Criar token de API"
JIRA_TOKEN=

# Código de acesso aos dados reais (as rotas /api exigem no cabeçalho x-radar-access).
# Sem ele na Vercel, a API nega tudo; no dev local, sem ele, a API fica liberada.
RADAR_ACCESS_CODE=

# Opcionais
# JIRA_BASE_URL=https://cogna.atlassian.net
# Força o campo de critérios de aceite (por padrão é descoberto pelo nome, ex.: "Critérios de Aceite")
# JIRA_AC_FIELD=customfield_XXXXX
